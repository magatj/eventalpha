# ---------------------------------------------------------------------------
# EventAlpha local configuration. Copy to `.env` (scripts/setup.ps1 does this).
# NEVER commit `.env`. All keys are optional: without them, use demo mode.
# ---------------------------------------------------------------------------

# demo = labeled synthetic data, no external calls. live = real providers.
# This is the startup default; it can be toggled at runtime in Settings.
DATA_MODE=demo

# PostgreSQL (docker-compose service "db"). From the host use localhost:5432.
POSTGRES_USER=eventalpha
POSTGRES_PASSWORD=eventalpha_local_dev
POSTGRES_DB=eventalpha
POSTGRES_PORT=5433
# Host port 5433 avoids clashing with a locally installed PostgreSQL on 5432.
# Used by the backend containers (host "db"). For running the API on the host,
# override with localhost:5433.
DATABASE_URL=postgresql+psycopg://eventalpha:eventalpha_local_dev@db:5432/eventalpha

# Massive (formerly Polygon.io) market data — https://massive.com
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
# Free "Stocks Basic" plan allows 5 requests/minute.
MASSIVE_REQUESTS_PER_MINUTE=5

# SEC EDGAR requires a descriptive User-Agent with contact info.
# Format: "AppName your-email@example.com"
SEC_USER_AGENT=EventAlpha personal-research your-email@example.com
SEC_REQUESTS_PER_SECOND=5

# OpenAI (optional). Without a key, a clearly labeled rule-based summary is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# USD per 1M tokens for spend tracking — check current OpenAI pricing.
OPENAI_INPUT_PRICE_PER_M=0.25
OPENAI_OUTPUT_PRICE_PER_M=2.00
# AI research chat (stock detail page). Uses the same OPENAI_API_KEY; the key never reaches the browser.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_CHAT_INPUT_PRICE_PER_M=0.25
OPENAI_CHAT_OUTPUT_PRICE_PER_M=2.00
CHAT_MAX_CONTEXT_TOKENS=12000               # EventAlpha data placed in each prompt (approx.)
CHAT_MAX_OUTPUT_TOKENS=4000                 # includes hidden reasoning tokens on reasoning models
CHAT_REASONING_EFFORT=low
CHAT_MONTHLY_BUDGET_USD=5                   # chat-only cap, inside AI_MONTHLY_BUDGET_USD
CHAT_MAX_HISTORY_MESSAGES=10                # older turns are folded into a short summary
CHAT_MAX_TOOL_ROUNDS=4
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_STALE_ANALYSIS_DAYS=7
AI_MONTHLY_BUDGET_USD=10
AI_CACHE_TTL_HOURS=24

# Forecasting defaults (model assumptions, editable)
RISK_FREE_RATE=0.0425
EQUITY_RISK_PREMIUM=0.05
PRE_TAX_COST_OF_DEBT=0.055
TAX_RATE=0.21

# Scheduler (America/New_York). Set false to disable all scheduled jobs.
SCHEDULER_ENABLED=true
NEWS_INGEST_INTERVAL_MINUTES=60

# Run the job worker inside the API process (handy when running without Docker).
EMBEDDED_WORKER=false

# Frontend → backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Stock discovery -----------------------------------------------------------
# dynamic = whole US-listed market (default); fixed = backend/app/data/universe.txt only.
DISCOVERY_UNIVERSE_MODE=dynamic
UNIVERSE_SECURITY_TYPES=CS,OS,ADRC          # Massive security types to list
UNIVERSE_EXCHANGES=XNYS,XNAS,XASE           # NYSE, Nasdaq, NYSE American
UNIVERSE_REFRESH_DAYS=7
SCREEN_MIN_MARKET_CAP=500000000
MIN_AVG_DOLLAR_VOLUME=20000000              # 20-day average dollar volume
SCREEN_MAX_PRICE_STALENESS=5                # trading sessions
SCREEN_MIN_PRICE_SESSIONS=20
SCREEN_HISTORY_SESSIONS=63                  # grouped-daily sessions kept (momentum/volatility)
CATALYST_MIN_MARKET_CAP=100000000           # smaller caps qualify only with an exceptional catalyst
CATALYST_MIN_AVG_DOLLAR_VOLUME=5000000
CATALYST_MIN_MATERIALITY=0.7
DYNAMIC_QUOTA_FINANCIAL=25
DYNAMIC_QUOTA_VALUATION=15
DYNAMIC_QUOTA_CATALYST=15
DYNAMIC_QUOTA_UNDEREXPLORED=5
DISCOVERY_MAX_CANDIDATES=60
DISCOVERY_TOP_N=20
DISCOVERY_AI_TOP_N=10
DISCOVERY_MIN_PUBLISH_SCORE=50              # publish fewer than TOP_N if quality is insufficient
SIC_ENRICH_PER_RUN=2500                     # SEC sector lookups per screening run
FILING_INDEX_LOOKBACK_DAYS=5
# Valuation guardrails — upside is never capped; unsupported results go to review (not ranked)
VALUATION_UPSIDE_REVIEW_THRESHOLD=1.0       # base 12m upside above this must be supported by evidence
VALUATION_MAX_UNSUPPORTED_RERATING=0.5      # base multiple > current x 1.5 needs historical support
# Screening data coverage (both free, bounded per run)
FUNDAMENTALS_FALLBACK_PER_RUN=400           # SEC companyfacts lookups for liquid stocks the frames API missed
FUNDAMENTALS_FALLBACK_MAX_AGE_DAYS=30
FUNDAMENTALS_FALLBACK_MIN_DOLLAR_VOLUME=5000000
PROVIDER_SHARES_PER_RUN=25                  # Massive ticker-details lookups per daily refresh (x6 on Sunday)
PROVIDER_SHARES_MAX_AGE_DAYS=30
NEWS_ROTATION_PER_RUN=6
