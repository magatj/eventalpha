# Copy to backend.hcl (git-ignored values are fine to keep here; no secrets).
# Create the bucket once, manually, with versioning + default encryption enabled.
bucket       = "your-terraform-state-bucket"
key          = "eventalpha/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native state locking (Terraform >= 1.10)
